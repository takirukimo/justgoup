{
  "name": "justgoup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JUST GO UP — a premium handheld 3D bouldering game on the CHIRAL wall.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "playwright-core": "^1.56.0"
  }
}
